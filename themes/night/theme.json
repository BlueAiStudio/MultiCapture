    "ornaments": [
      {"image": "deco/moon.png", "anchor": "ne", "size": 130, "offset": [18, -18]},
      {"image": "deco/star.png", "anchor": "nw", "size": 40, "offset": [-6, -6]},
      {"image": "deco/sparkle.png", "anchor": "sw", "size": 30, "offset": [-4, 8]},
      {"image": "deco/star.png", "anchor": "se", "size": 26, "offset": [6, 8]},
      {"image": "deco/sparkle.png", "anchor": "n", "size": 22, "offset": [-120, -14]}
    ]
  }
